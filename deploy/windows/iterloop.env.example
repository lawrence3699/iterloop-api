# IterLoop API shadow instance. Copy to iterloop.env and replace every secret.
PORT=28517
BIND_ADDRESS=127.0.0.1
NODE_TYPE=master
SYSTEM_NAME=IterLoop API
SYSTEM_LOGO=/logo.png
TZ=Australia/Sydney

# PostgreSQL 15. Use a dedicated database and login.
SQL_DSN=postgres://iterloop:replace-db-password@127.0.0.1:5432/iterloop?sslmode=disable
SQL_MAX_IDLE_CONNS=20
SQL_MAX_OPEN_CONNS=80
SQL_MAX_LIFETIME=300

# Generate independent random values. Never reuse CLIProxyAPI or old gateway keys.
SESSION_SECRET=replace-with-at-least-32-random-characters
CRYPTO_SECRET=replace-with-an-independent-32-character-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://console.iter-loop.com,https://admin.iter-loop.com

# Host isolation.
ITERLOOP_PUBLIC_HOSTS=iter-loop.com
ITERLOOP_CONSOLE_HOST=console.iter-loop.com
ITERLOOP_API_HOST=api.iter-loop.com
ITERLOOP_ADMIN_HOST=admin.iter-loop.com

# Existing Windows reverse SSH endpoint to ai-mac CLIProxyAPI.
ITERLOOP_UPSTREAM_MANAGEMENT_URL=http://127.0.0.1:28317
ITERLOOP_UPSTREAM_MANAGEMENT_KEY=replace-with-cliproxy-management-key

# Resend SMTP. The iter-loop.com sender domain must be verified first.
SMTP_SERVER=smtp.resend.com
SMTP_PORT=587
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
SMTP_ACCOUNT=resend
SMTP_FROM=noreply@iter-loop.com
SMTP_TOKEN=replace-with-resend-api-key
EMAIL_VERIFICATION_ENABLED=true
REGISTER_ENABLED=true
PASSWORD_LOGIN_ENABLED=true
PASSWORD_REGISTER_ENABLED=true

# Cloudflare Turnstile widgets must include console.iter-loop.com and admin.iter-loop.com.
TURNSTILE_CHECK_ENABLED=true
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Conservative first-phase limits for the 30-concurrency target.
MEMORY_CACHE_ENABLED=true
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=360
GLOBAL_API_RATE_LIMIT_DURATION=180
RELAY_MAX_IDLE_CONNS=200
RELAY_MAX_IDLE_CONNS_PER_HOST=60
STREAMING_TIMEOUT=300
SHUTDOWN_TIMEOUT_SECONDS=120
ERROR_LOG_ENABLED=true
